<?xml version="1.0" encoding="utf-8"?>
<!-- Blue rounded button (Login, Next Step, Login with google, ...). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/fi_button_active" />
            <stroke android:width="1dp" android:color="@color/fi_outline" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/fi_input" />
            <stroke android:width="1dp" android:color="@color/fi_outline" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
