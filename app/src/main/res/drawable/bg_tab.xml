<?xml version="1.0" encoding="utf-8"?>
<!-- The Lost / Found tabs on the Items screen: lighter blue when selected. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/fi_button" />
            <stroke android:width="1dp" android:color="@color/fi_outline" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/fi_search_bar" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
