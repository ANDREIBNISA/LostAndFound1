<?xml version="1.0" encoding="utf-8"?>
<!-- Sidebar button. setSelected(true) in Java turns it the darker "current screen" blue. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/fi_button_active" />
            <stroke android:width="1dp" android:color="@color/fi_outline" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/fi_button_active" />
            <stroke android:width="1dp" android:color="@color/fi_outline" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/fi_button" />
            <stroke android:width="1dp" android:color="@color/fi_outline" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
