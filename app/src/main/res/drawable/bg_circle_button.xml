<?xml version="1.0" encoding="utf-8"?>
<!-- Round blue button (the + on Messages). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/fi_button_active" />
            <stroke android:width="1dp" android:color="@color/fi_outline" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/fi_input" />
            <stroke android:width="1dp" android:color="@color/fi_outline" />
        </shape>
    </item>
</selector>
