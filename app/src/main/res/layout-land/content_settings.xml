<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape Settings: five tabs in a column on the left, the matching page on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="14dp"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="Settings"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Tabs -->
        <ScrollView
            android:layout_width="150dp"
            android:layout_height="match_parent"
            android:background="@color/fi_sidebar"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/tabAccount"
                    style="@style/FoundIt.SidebarButton"
                    android:text="Account Information"
                    android:textSize="11sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/tabSecurity"
                    style="@style/FoundIt.SidebarButton"
                    android:text="Security"
                    android:textSize="11sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/tabNotifications"
                    style="@style/FoundIt.SidebarButton"
                    android:text="Notifications"
                    android:textSize="11sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/tabPreferences"
                    style="@style/FoundIt.SidebarButton"
                    android:text="App preferences"
                    android:textSize="11sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/tabOther"
                    style="@style/FoundIt.SidebarButton"
                    android:text="Other settings"
                    android:textSize="11sp" />
            </LinearLayout>
        </ScrollView>

        <!-- Pages -->
        <include
            layout="@layout/settings_pages"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
