<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 03: Make a report, step 1 of 3 (item details). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="14dp"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Making a report\nStep 1/3: Item details"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            style="@style/FoundIt.Label"
            android:layout_marginStart="4dp"
            android:layout_marginTop="8dp"
            android:text="Item name" />

        <EditText
            android:id="@+id/itemNameInput"
            style="@style/FoundIt.Input"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="2dp"
            android:hint="Black leather wallet"
            android:inputType="textCapSentences" />

        <TextView
            style="@style/FoundIt.Label"
            android:layout_marginStart="4dp"
            android:layout_marginTop="6dp"
            android:text="Item Owner or Item Finder" />

        <EditText
            android:id="@+id/ownerInput"
            style="@style/FoundIt.Input"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="2dp"
            android:hint="Juan Dela Cruz"
            android:inputType="textPersonName" />

        <TextView
            style="@style/FoundIt.Label"
            android:layout_marginStart="4dp"
            android:layout_marginTop="6dp"
            android:text="Lost/Found at" />

        <EditText
            android:id="@+id/locationInput"
            style="@style/FoundIt.Input"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="2dp"
            android:hint="Canteen table"
            android:inputType="textCapSentences" />

        <TextView
            style="@style/FoundIt.Label"
            android:layout_marginStart="4dp"
            android:layout_marginTop="6dp"
            android:text="Contact details" />

        <EditText
            android:id="@+id/emailInput"
            style="@style/FoundIt.Input"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="2dp"
            android:hint="Email"
            android:inputType="textEmailAddress" />

        <EditText
            android:id="@+id/mobileInput"
            style="@style/FoundIt.Input"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="4dp"
            android:hint="Mobile number"
            android:inputType="phone" />

        <EditText
            android:id="@+id/alternateContactInput"
            style="@style/FoundIt.Input"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="4dp"
            android:hint="Alternate contact (Ex. Social Media)"
            android:imeOptions="flagNoExtractUi|actionDone"
            android:inputType="text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <CheckBox
                    android:id="@+id/lostItemCheck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:button="@drawable/checkbox_selector"
                    android:paddingStart="8dp"
                    android:text="Lost item"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/foundItemCheck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:button="@drawable/checkbox_selector"
                    android:paddingStart="8dp"
                    android:text="Found item"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/nextStepButton"
                style="@style/FoundIt.Button"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_action_button"
                android:drawableEnd="@drawable/ic_arrow_next"
                android:drawablePadding="8dp"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:text="Next Step"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/importDetailsButton"
                    style="@style/FoundIt.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_small_button"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Import details from settings"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
