<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape Messages: chat list on the left, conversation area on the right.
     The rows inside chatList are copies of item_chat_row.xml made by MessagesActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="14dp"
    android:background="@drawable/bg_panel"
    android:orientation="horizontal">

    <!-- Left: list of chats, with a + button to message a new user -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="38"
        android:background="@drawable/bg_messages_list"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingTop="12dp"
        android:paddingEnd="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Messages"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/newMessageButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_button"
                android:clickable="true"
                android:contentDescription="New message"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_add" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/chatList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- Right: the open conversation. It scrolls when the bubbles do not fit. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="62"
        android:orientation="vertical"
        android:padding="8dp">

        <ScrollView
            android:id="@+id/chatScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <include layout="@layout/include_conversation" />
        </ScrollView>

        <include layout="@layout/include_chat_input" />
    </LinearLayout>
</LinearLayout>
