<?xml version="1.0" encoding="utf-8"?>
<!-- Portrait item card (lost): wide, with the picture on the left like the phone mock. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:onClick="onItemCardClick"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:layout_width="76dp"
        android:layout_height="54dp"
        android:contentDescription="Item picture"
        android:scaleType="fitXY"
        android:src="@drawable/ic_picture_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            style="@style/FoundIt.CardText"
            android:text="Item:"
            android:textSize="16sp" />

        <TextView
            style="@style/FoundIt.CardText"
            android:text="Lost by: User67"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
