<?xml version="1.0" encoding="utf-8"?>
<!-- Portrait Reports screen: a "Make a report" button on top, the current reports, and a
     "Previous reports" section that starts closed. When there are no current reports, the
     empty message and "Create a report" button take their place. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fi_content_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            style="@style/FoundIt.SectionTitle"
            android:text="Reports"
            android:textSize="22sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/makeReportButton"
            style="@style/FoundIt.Button"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_action_button"
            android:text="Make a report"
            android:textSize="16sp" />

        <!-- Shown only when there are no current reports. -->
        <LinearLayout
            android:id="@+id/reportsEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="No reports"
                android:src="@drawable/ic_nav_reports" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="You currently don't have reports right now."
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/createReportButton"
                style="@style/FoundIt.Button"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_small_button"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="Create a report"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- The current reports. The cards are copies of item_report.xml made by Java. -->
        <LinearLayout
            android:id="@+id/currentReportsGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <TextView
                style="@style/FoundIt.Label"
                android:text="Current reports"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/currentReportsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Previous reports: closed until you tap the row. -->
        <LinearLayout
            android:id="@+id/previousHeader"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card_dark"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Previous reports"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/previousChevron"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="Show or hide previous reports"
                android:src="@drawable/ic_chevron_down" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/previousReportsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
