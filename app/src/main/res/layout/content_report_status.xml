                android:textSize="11sp" />

            <TextView
                style="@style/FoundIt.Cell"
                android:layout_weight="2"
                android:text="Report date"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/selectAllCheck"
                style="@style/FoundIt.CellCheck" />
        </LinearLayout>

