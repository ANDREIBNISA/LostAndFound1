<?xml version="1.0" encoding="utf-8"?>
<!-- Sign up screen. Same building photo and dark-blue card as Login, with the account form inside. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/signUpRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/fi_topbar">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/login_building" />

    <!-- The "white haze" over the photo. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fi_login_haze" />

    <!-- The form is taller than a phone on its side, so the card scrolls. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="1dp">

            <LinearLayout
                android:layout_width="320dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_login_card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="FoundIt: An app\nbuilt by students"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <!-- Date of Birth: one white box with three parts -->
                <TextView
                    style="@style/FoundIt.Label"
                    android:layout_marginTop="6dp"
                    android:text="Date of Birth" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/bg_input_white"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/birthMonthInput"
                        style="@style/FoundIt.DatePart"
                        android:hint="MM"
                        android:importantForAutofill="no"
                        android:maxLength="2" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="|"
                        android:textColor="@color/fi_hint_dark"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/birthDayInput"
                        style="@style/FoundIt.DatePart"
                        android:hint="DD"
                        android:importantForAutofill="no"
                        android:maxLength="2" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="|"
                        android:textColor="@color/fi_hint_dark"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/birthYearInput"
                        style="@style/FoundIt.DatePart"
                        android:hint="YYYY"
                        android:importantForAutofill="no"
                        android:maxLength="4" />
                </LinearLayout>

                <TextView
                    style="@style/FoundIt.Label"
                    android:layout_marginTop="6dp"
                    android:text="Username" />

                <EditText
                    android:id="@+id/signUpUsernameInput"
                    style="@style/FoundIt.InputWhite"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="2dp"
                    android:autofillHints="username"
                    android:hint="Ex. “JohnDoe26”"
                    android:inputType="text" />

                <TextView
                    style="@style/FoundIt.Label"
                    android:layout_marginTop="6dp"
                    android:text="Email/Mobile number" />

                <EditText
                    android:id="@+id/signUpEmailInput"
                    style="@style/FoundIt.InputWhite"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="2dp"
                    android:autofillHints="emailAddress"
                    android:hint="Ex. “johndoe@email.com”"
                    android:inputType="textEmailAddress" />

                <TextView
                    style="@style/FoundIt.Label"
                    android:layout_marginTop="6dp"
                    android:text="Password" />

                <EditText
                    android:id="@+id/signUpPasswordInput"
                    style="@style/FoundIt.InputWhite"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="2dp"
                    android:autofillHints="newPassword"
                    android:hint="Password"
                    android:inputType="textPassword" />

                <!-- Contact details (Optional) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/FoundIt.Label"
                        android:text="Contact details"
                        android:textSize="15sp" />

                    <TextView
                        style="@style/FoundIt.Label"
                        android:layout_marginStart="6dp"
                        android:text="(Optional)"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    style="@style/FoundIt.Label"
                    android:layout_marginTop="4dp"
                    android:text="Contact number" />

                <EditText
                    android:id="@+id/contactNumberInput"
                    style="@style/FoundIt.InputWhite"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="2dp"
                    android:autofillHints="phone"
                    android:hint="Ex. +63 273523510"
                    android:inputType="phone" />

                <TextView
                    style="@style/FoundIt.Label"
                    android:layout_marginTop="6dp"
                    android:text="Alternate contact" />

                <EditText
                    android:id="@+id/signUpAlternateContactInput"
                    style="@style/FoundIt.InputWhite"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="2dp"
                    android:hint="Eg. Social Media"
                    android:imeOptions="flagNoExtractUi|actionDone"
                    android:importantForAutofill="no"
                    android:inputType="text" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Contact details will never be used outside of this platform"
                    android:textColor="@color/white"
                    android:textSize="10sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/createAccountButton"
                    style="@style/FoundIt.Button"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_green_button"
                    android:text="Create Account"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/termsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/sign_up_terms"
                    android:textColor="@color/white"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/loginLinkText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:padding="2dp"
                    android:text="@string/login_prompt"
                    android:textColor="@color/white"
                    android:textSize="11sp" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</FrameLayout>
