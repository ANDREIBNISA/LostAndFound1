<?xml version="1.0" encoding="utf-8"?>
<!-- Portrait Settings: the five tabs in a row across the top, the matching page underneath. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fi_content_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Settings"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Tabs: slide sideways if they do not all fit -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@color/fi_sidebar"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="3dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/tabAccount"
                    style="@style/FoundIt.SidebarButton"
                    android:layout_width="wrap_content"
                    android:text="Account Information"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/tabSecurity"
                    style="@style/FoundIt.SidebarButton"
                    android:layout_width="wrap_content"
                    android:text="Security"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/tabNotifications"
                    style="@style/FoundIt.SidebarButton"
                    android:layout_width="wrap_content"
                    android:text="Notifications"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/tabPreferences"
                    style="@style/FoundIt.SidebarButton"
                    android:layout_width="wrap_content"
                    android:text="App preferences"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/tabOther"
                    style="@style/FoundIt.SidebarButton"
                    android:layout_width="wrap_content"
                    android:text="Other settings"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Pages -->
        <include
            layout="@layout/settings_pages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
