<?xml version="1.0" encoding="utf-8"?>
<!-- Making a report, step 2 of 3 (more details), used by both orientations. Designed by Claude
     in the style of step 1, because the worksheet does not include it. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fi_content_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="14dp"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Making a report\nStep 2/3: More details"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            style="@style/FoundIt.Label"
            android:layout_marginStart="4dp"
            android:layout_marginTop="10dp"
            android:text="Description" />

        <EditText
            android:id="@+id/descriptionInput"
            style="@style/FoundIt.Input"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="2dp"
            android:gravity="top|start"
            android:hint="Color, size, stickers, anything that proves it is yours"
            android:inputType="textCapSentences|textMultiLine"
            android:paddingTop="8dp"
            android:singleLine="false" />

        <TextView
            style="@style/FoundIt.Label"
            android:layout_marginStart="4dp"
            android:layout_marginTop="8dp"
            android:text="Category" />

        <Spinner
            android:id="@+id/categorySpinner"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_spinner"
            android:entries="@array/categories"
            android:paddingStart="6dp"
            android:paddingEnd="36dp"
            android:theme="@style/ThemeOverlay.AppCompat.Light" />

        <TextView
            style="@style/FoundIt.Label"
            android:layout_marginStart="4dp"
            android:layout_marginTop="8dp"
            android:text="Date lost or found" />

        <EditText
            android:id="@+id/dateInput"
            style="@style/FoundIt.Input"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="2dp"
            android:hint="MM/DD/YYYY"
            android:imeOptions="flagNoExtractUi|actionDone"
            android:inputType="date" />

        <TextView
            style="@style/FoundIt.Label"
            android:layout_marginStart="4dp"
            android:layout_marginTop="8dp"
            android:text="Photo (optional)" />

        <LinearLayout
            android:id="@+id/photoBox"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_input"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Add a photo"
                android:src="@drawable/ic_picture_placeholder" />

            <TextView
                android:id="@+id/photoText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tap to add a photo"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/backButton"
                style="@style/FoundIt.Button"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_small_button"
                android:text="Back"
                android:textSize="16sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/nextStepButton"
                style="@style/FoundIt.Button"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1.4"
                android:background="@drawable/bg_action_button"
                android:drawableEnd="@drawable/ic_arrow_next"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Next Step"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
