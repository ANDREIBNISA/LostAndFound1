<?xml version="1.0" encoding="utf-8"?>
<!-- Item details, used by both orientations. Opened by tapping an item card. Designed by Claude
     because the worksheet has no such screen. All text is placeholder. The kind (Lost / Found)
     is filled in by ItemDetailsActivity. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fi_content_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="14dp"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/detailsTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Item details"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detailsKind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_chip"
                android:paddingStart="12dp"
                android:paddingTop="3dp"
                android:paddingEnd="12dp"
                android:paddingBottom="3dp"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="10dp"
            android:contentDescription="Item picture"
            android:scaleType="fitXY"
            android:src="@drawable/ic_picture_placeholder" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Black leather wallet"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detailsBy"
            style="@style/FoundIt.Label"
            android:layout_marginTop="2dp"
            android:textSize="14sp" />

        <TextView
            style="@style/FoundIt.Label"
            android:layout_marginTop="12dp"
            android:text="Where and when"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Canteen table  •  September 11, 2026"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <TextView
            style="@style/FoundIt.Label"
            android:layout_marginTop="12dp"
            android:text="Description"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Black leather wallet with a worn corner and a blue sticker inside."
            android:textColor="@color/white"
            android:textSize="14sp" />

        <TextView
            style="@style/FoundIt.Label"
            android:layout_marginTop="12dp"
            android:text="Contact details"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email: johndoe26@email.com"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alternative contact: @johndoe26"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/messageOwnerButton"
            style="@style/FoundIt.Button"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_action_button"
            android:text="Send a message"
            android:textSize="16sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/backButton"
            style="@style/FoundIt.Button"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_small_button"
            android:text="Back"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
