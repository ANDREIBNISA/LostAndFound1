<?xml version="1.0" encoding="utf-8"?>
<!-- The open conversation in Messages: who you are talking to, then the chat bubbles.
     Their messages are on the left, yours are on the right. Used by both orientations.
     The bubble texts are placeholders until real messages come from the database. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/conversation"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Header: avatar and name of the other person -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Profile picture"
            android:src="@drawable/ic_avatar" />

        <TextView
            android:id="@+id/chatTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="User67890"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <include layout="@layout/include_chat_bubbles" />
</LinearLayout>
