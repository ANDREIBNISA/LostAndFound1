<?xml version="1.0" encoding="utf-8"?>
<!-- Profile body, used by both orientations: avatar and numbers, a few lines about the
     person, two buttons, four icon tabs, and the list that belongs to the chosen tab.
     All names and numbers are placeholders. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fi_content_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:contentDescription="Profile picture"
                android:src="@drawable/ic_avatar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="John Doe"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User12345"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12 Reports"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="5 Found"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="3 Returned"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Information about the person (placeholder text). -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Student, Grade 11"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Member since September 2026"
            android:textColor="@color/fi_hint"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Contact: johndoe26@email.com"
            android:textColor="@color/fi_hint"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/editProfileButton"
                style="@style/FoundIt.Button"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_action_button"
                android:text="Edit profile"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/closedReportsButton"
                style="@style/FoundIt.Button"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_action_button"
                android:text="Closed reports"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Four icon tabs: My reports, Found items, Returned items, Saved. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/profileTab1"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_profile_tab"
                android:clickable="true"
                android:contentDescription="My reports"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_tab_grid"
                android:tint="@color/tab_icon_color" />

            <ImageView
                android:id="@+id/profileTab2"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_profile_tab"
                android:clickable="true"
                android:contentDescription="Found items"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_tab_found"
                android:tint="@color/tab_icon_color" />

            <ImageView
                android:id="@+id/profileTab3"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_profile_tab"
                android:clickable="true"
                android:contentDescription="Returned items"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_tab_returned"
                android:tint="@color/tab_icon_color" />

            <ImageView
                android:id="@+id/profileTab4"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_profile_tab"
                android:clickable="true"
                android:contentDescription="Saved items"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_tab_saved"
                android:tint="@color/tab_icon_color" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/fi_nav_gray" />

        <TextView
            android:id="@+id/profileTabTitle"
            style="@style/FoundIt.Label"
            android:layout_marginTop="12dp"
            android:textSize="14sp" />

        <!-- Copies of item_profile_card.xml, made by ProfileActivity for the chosen tab. -->
        <LinearLayout
            android:id="@+id/profileList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/profileEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:textColor="@color/fi_hint"
            android:textSize="15sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
